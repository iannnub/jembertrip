# ==============================================================================
# JEMBERTRIP FRONTEND ENVIRONMENT VARIABLES TEMPLATE
# Copy file ini menjadi .env dan sesuaikan nilainya.
# ==============================================================================

# URL Base API Backend FastAPI
VITE_API_BASE_URL=http://localhost:8000

# Google Analytics 4 (GA4) Measurement ID
# Dapatkan dari Google Analytics -> Admin -> Data Streams -> Measurement ID (G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Cloudflare Turnstile CAPTCHA Site Key (Client-side)
# Gunakan key demo (1x00000000000000000000AA) untuk local testing
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
