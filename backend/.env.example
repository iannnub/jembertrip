# ==============================================================================
# JEMBERTRIP BACKEND ENVIRONMENT VARIABLES TEMPLATE
# Copy file ini menjadi .env dan isi nilai yang sesuai untuk environment Anda.
# ==============================================================================

# Database Connection (SQLite default, ganti ke PostgreSQL di production)
DATABASE_URL=sqlite:///jembertrip.db

# JWT & Authentication Secret Key (Wajib ganti di production!)
SECRET_KEY=change_me_to_a_very_secure_random_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=30

# Admin Master Key (Digunakan saat setup admin via API / cli)
ADMIN_MASTER_KEY=your_admin_master_key_here

# Groq Cloud LLM API Keys (Bisa gunakan rotasi key)
GROQ_API_KEY_1=gsk_your_groq_api_key_here

# Cloudflare Turnstile CAPTCHA Secret Key
CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAA...your_secret_key_here

# Sentry Monitoring & Error Reporting DSN (Opsional di dev, sangat disarankan di prod)
# Contoh: https://abcdef1234567890@o123456.ingest.sentry.io/1234567
SENTRY_DSN=

# Production / Public Domain URL
PUBLIC_URL=http://localhost:8000
